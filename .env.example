# ---------------------------------------------------------------
# THE HOPE SCIENCE ACADEMY - Academic & Examination Management System
#
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# PostgreSQL connection. On Vercel, adding a Neon database from the
# Storage tab fills both of these in automatically.
#
#   DATABASE_URL  pooled  - used by the running application
#   DIRECT_URL    direct  - used by migrations, which cannot run through a pooler
#
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Public address of the site. Appears inside the QR codes printed on
# report cards and certificates, so it must be the address parents visit.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session lifetime and idle auto-logout, in minutes.
SESSION_LIFETIME_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=60

# ---------------------------------------------------------------
# First-run setup only (npm run db:bootstrap). These create the very
# first sign-in on an empty database; remove them once it exists.
# ---------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=""

# Optional - override the academy's details at first run. They can also
# be changed later under Administration > Academy Settings.
# ACADEMY_NAME="The Hope Science Academy"
# ACADEMY_SHORT_NAME="HSA"
# ACADEMY_ADDRESS="247/E-1, Johar Town, Lahore"
# ACADEMY_PHONE1="0322-4157001"
# ACADEMY_PHONE2="0300-8194789"

# ---------------------------------------------------------------
# Supabase client libraries. Only needed if the browser talks to
# Supabase directly; the application's own data access goes through
# Prisma using DATABASE_URL above.
#
# The publishable key is safe to expose ONLY when the Data API is
# switched off, or every table has row level security enabled.
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
